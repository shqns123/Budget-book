# .env.local로 복사해서 채우세요 (git에 올라가지 않음).

# 가계부 서버 주소 (https, 끝에 / 없이).
#   개발(Expo Go): 로그인 화면의 서버 주소 칸에 미리 채워져요. 다른 주소로 바꿔 로그인할 수도 있어요.
#   APK/EAS 빌드: eas.json의 build.preview/production env 값이 앱에 들어가고, 서버 주소 칸이 사라져요.
EXPO_PUBLIC_API_URL=https://ledger.example.synology.me

# Google 로그인: 서버 .env의 GOOGLE_CLIENT_ID와 같은 "웹" 클라이언트 ID (비밀 값 아님).
#   없으면 로그인 화면에 아이디·비밀번호 칸만 나와요. Expo Go에서는 Google 로그인이 안 돼요(개발용 앱 필요).
#   빌드용은 eas.json의 build.*.env에도 같은 값을 넣어요.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
