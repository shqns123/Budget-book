{
  "expo": {
    "name": "잔잔한 가계부",
    "slug": "budget-book",
    "scheme": "budgetbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5f6f8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.budgetbook.mobile"
    },
    "android": {
      "package": "com.budgetbook.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#fbe1d1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "은행 앱 화면이나 영수증 사진에서 거래를 불러오기 위해 사진에 접근해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#fbe1d1",
          "dark": {
            "backgroundColor": "#101318"
          }
        }
      ],
      "expo-font",
      "./plugins/withLocalAndroidBuild"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b4c08ea9-4fe0-4e40-a690-cb42a79f3572"
      }
    },
    "owner": "woojinsong"
  }
}
