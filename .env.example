SQLITE_DATABASE_PATH=/app/data/ledger.db
AUTH_USERNAME=your-login-id
AUTH_PASSWORD=replace-with-a-long-unique-password
AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
OPENROUTER_MODEL=openai/gpt-5.4-mini
# Optional: public URL shown in OpenRouter usage metadata
OPENROUTER_SITE_URL=https://ledger.example.com
